# Primary worker for latency-sensitive analytics jobs plus ordinary default
# work. Notification deliveries are isolated in queue-notifications-worker.service
# so a slow mail/SMS gateway cannot occupy the analytics worker.
#
# Install:
#   sudo cp deploy/queue-worker.service /etc/systemd/system/imreport-queue.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now imreport-queue.service
#
# Then set QUEUE_WORKER_MODE=daemon in backend/.env (disables the cron-tick
# fallback) and run: php artisan config:cache
#
# app:launch-readiness verifies this unit is active.

[Unit]
Description=St Paul's IM reporting queue worker
After=network.target mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/imreport/current/backend
ExecStart=/usr/bin/php artisan queue:work --queue=analytics,default --tries=3 --backoff=10 --max-time=3600
Restart=always
RestartSec=5
StandardOutput=append:/var/log/imreport-queue.log
StandardError=append:/var/log/imreport-queue.log

[Install]
WantedBy=multi-user.target
