# Frontend (Vite) browser runtime. Copy to .env.local for local dev; in
# production these are injected by the deploy platform (e.g. Cloudflare Pages).
#
# Locally, /api and /sanctum are proxied to the Laravel backend (see
# vite.config.ts), so the API base URL points at the Vite origin to keep the
# SPA and API same-origin for Sanctum cookie auth. In production, set this to
# the real API origin.
VITE_API_BASE_URL=http://localhost:5173

# Optional Laravel Reverb (realtime). Leave blank if realtime is not enabled.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Backend (Laravel) environment lives in backend/.env — see backend/.env.example.
