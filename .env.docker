# =========================================================================
# Environment for the LOCAL Docker production-parity stack ONLY.
#
# This file is NOT backend/.env and must never be copied to a real server.
# Every value below is a throwaway local placeholder. The stack is disposable:
# the database lives in a docker volume and is recreated with `down -v`.
#
# Shape follows deploy/README.md step 7 (the production variable set).
# =========================================================================

APP_NAME="St Paul's Reporting API"
APP_ENV=production
APP_DEBUG=false
# Local-parity-stack key. Rotated per environment in reality; this one is
# published in the repo on purpose so the stack boots with no manual step.
# NEVER reuse it anywhere that holds real data.
APP_KEY=base64:AfvoVMBrcUWHoJynmTrPj5Vknm5U2LRU5DBAqkTzQAA=
APP_URL=https://localhost:8443
FRONTEND_URL=https://localhost:8443
APP_TIMEZONE=UTC
HOSPITAL_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# nginx terminates TLS in front of PHP-FPM, exactly like the department server.
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: MariaDB, never the dev SQLite file -------------------------
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=imreport
DB_USERNAME=imreport
# Local-only placeholder credential for a disposable container database.
DB_PASSWORD=local-parity-stack

# --- Session / cache / queue all on the database (no Redis, per V2) -------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
# daemon => routes/console.php stops registering the cron-tick queue:work
# fallback, because the dedicated queue service owns it (queue-worker.service).
QUEUE_WORKER_MODE=daemon
QUEUE_WORKER_SERVICE=imreport-queue.service

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Same-origin SPA: one hostname, no CORS.
SANCTUM_STATEFUL_DOMAINS=localhost:8443,127.0.0.1:8443
CORS_ALLOWED_ORIGINS=https://localhost:8443

REPORT_WINDOW_DEFAULT_COUNT=9
REPORT_WINDOW_MAX_COUNT=104

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="St Paul's Reporting API"
SMS_DRIVER=log

# Readiness-check host signals. app:launch-readiness --strict inspects these;
# see docker/README.md for which of its checks cannot pass in a container.
BACKUP_DIR=/var/backups/imreport
SECONDARY_BACKUP_DIR=/mnt/backup/imreport
BACKUP_RESTORE_MAX_AGE_DAYS=90
MIN_FREE_DISK_GB=1
ERROR_MONITORING_CHANNEL=local-parity-stack-stderr

# --- Stack-only switches (not application settings) -----------------------
# The Dev*Seeder classes self-guard against APP_ENV=production. Setting this to
# true makes the SEED STEP ONLY run as APP_ENV=local so the stack has realistic
# data volume and the known dev admin login. The running app stays production.
STACK_SEED_DEV_DATA=true
