APP_NAME="St Paul Reporting API"
APP_ENV=local
APP_KEY=
# Secure by default. Set APP_DEBUG=true ONLY for local development, never in
# staging/production, where it leaks stack traces, env values, and SQL.
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=UTC
HOSPITAL_TIMEZONE=Africa/Nairobi
TRUSTED_PROXIES=

# Production readiness host signals. Set BACKUP_RESTORE_VERIFIED_AT after a
# successful restore drill, and refresh it at least every 90 days.
BACKUP_DIR=/var/backups/imreport
SECONDARY_BACKUP_DIR=/mnt/backup/imreport
BACKUP_RESTORE_VERIFIED_AT=
BACKUP_RESTORE_MAX_AGE_DAYS=90
ERROR_MONITORING_CHANNEL=
QUEUE_WORKER_SERVICE=imreport-queue.service
MIN_FREE_DISK_GB=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (zero-install). Switch to MariaDB/MySQL for staging/prod.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=stpaul_reporting
# DB_USERNAME=stpaul
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# MUST be true in production (HTTPS). Left unset here so config/session.php's
# default (secure when APP_ENV=production) applies; set =false only for local HTTP.
# SESSION_SECURE_COOKIE=true

# Sanctum SPA-cookie auth: list every origin the frontend may run on.
# In production, drop the localhost entries and add the real frontend host.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1

# Used by config/cors.php. Comma-separated. Defaults to FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default to "log" because shared hosting cannot keep a long-lived Reverb WebSocket
# daemon alive, and the SPA falls back to polling. Only set this to "reverb"
# if you are running the Reverb server on a host that supports it.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# How much report history a single workspace/dashboard payload may span.
# default_count = periods loaded on a normal dashboard; max_count = hard ceiling
# even for "all available data" so the payload never grows without bound.
REPORT_WINDOW_DEFAULT_COUNT=9
REPORT_WINDOW_MAX_COUNT=104

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS delivery. Use SMS_DRIVER=log locally; set SMS_DRIVER=http plus gateway
# endpoint/token on the host. Field names are configurable for simple HTTP APIs.
SMS_DRIVER=log
SMS_FROM=
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_HTTP_TO_FIELD=to
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_FROM_FIELD=from
SMS_HTTP_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (Laravel WebSocket server) - regenerate keys via `php artisan reverb:start`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
