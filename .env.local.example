# Copy this file to .env.local for local browser development.
# Requests to /api and /sanctum are proxied to the Laravel backend via
# vite.config.ts, so point the API base URL at the Vite origin. This keeps the
# SPA and API same-origin, which Sanctum's SameSite session/XSRF cookies need.
VITE_API_BASE_URL=http://localhost:5173

# Optional content-free real-user performance telemetry. Production defaults to
# a 10% sample; set 0 to disable or a value from 0 to 1 to override.
VITE_RUM_SAMPLE_RATE=0
# Set to the deployed git SHA in the production build pipeline.
VITE_RELEASE_SHA=local

# Optional Laravel Reverb (realtime). Leave blank if realtime is not enabled.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Week the system went live; periods before it are hidden everywhere. Leave unset
# in production. Set it (and backend REPORT_WINDOW_LIVE_START) to a fixture start
# date to browse a seeded multi-year archive locally.
# VITE_LIVE_REPORTING_START=2024-08-05
