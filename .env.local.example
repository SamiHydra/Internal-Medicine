# Copy this file to .env.local for local browser development.
# Laravel API used by the migration backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Supabase values are kept for rollback/legacy scripts until cutover is complete.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
