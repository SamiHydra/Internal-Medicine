# Copy this file to .env.local for local browser development.
# Requests to /api and /sanctum are proxied to the Laravel backend via
# vite.config.ts, so point the API base URL at the Vite origin. This keeps the
# SPA and API same-origin, which Sanctum's SameSite session/XSRF cookies need.
VITE_API_BASE_URL=http://localhost:5173

# Optional Laravel Reverb (realtime). Leave blank if realtime is not enabled.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
